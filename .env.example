# ============================================================
# Chat IA — variáveis de ambiente
# Copie para .env e preencha os valores reais.
# NUNCA commite o .env.
# ============================================================

# --- Banco de dados ---
# Aponte para o banco dedicado a este projeto dentro do servidor compartilhado
DATABASE_URL=postgresql://user:password@host:5432/chatia_development

# Banco de testes (container db-test do compose.dev.yml — não altere em dev)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/chatia_test

# --- Redis ---
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=changeme_in_production

# --- Autenticação ---
DEVISE_JWT_SECRET_KEY=generate_with_rails_secret_64_chars_minimum

# --- Abacus.ai / RouteLLM ---
ABACUS_API_KEY=your_abacus_api_key_here
ABACUS_API_URL=https://apps.abacus.ai/api/v0/

# Modelo padrão quando a conversa não tem modelo selecionado
DEFAULT_LLM_MODEL=gpt-4o-mini

# --- Frontend ---
FRONTEND_URL=http://localhost:5173

# --- Rails ---
RAILS_MASTER_KEY=paste_value_from_backend/config/master.key
RAILS_MAX_THREADS=5
SIDEKIQ_CONCURRENCY=5

# --- Monitoring ---
GRAFANA_PASSWORD=changeme
GRAFANA_URL=http://localhost:3001

# --- Erros ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Email (opcional) ---
MAILER_FROM=noreply@chatia.dev
