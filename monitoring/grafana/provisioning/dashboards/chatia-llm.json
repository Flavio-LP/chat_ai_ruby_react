{
  "title": "Chat IA — LLM Metrics",
  "uid": "chatia-llm",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "LLM Requests/min",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "rate(llm_requests_total[1m])",
          "legendFormat": "{{model}} - {{status}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Tokens/min",
      "type": "timeseries",
      "gridPos": { "x": 6, "y": 0, "w": 18, "h": 8 },
      "targets": [
        {
          "expr": "rate(llm_tokens_total[1m])",
          "legendFormat": "{{model}} - {{direction}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Custo USD acumulado",
      "type": "stat",
      "gridPos": { "x": 0, "y": 4, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "sum(llm_cost_usd_total)",
          "legendFormat": "Total"
        }
      ]
    },
    {
      "id": 4,
      "title": "Latência P95 (s)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(llm_latency_seconds_bucket[5m]))",
          "legendFormat": "P95 {{model}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Time to First Token P95 (s)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(llm_time_to_first_token_seconds_bucket[5m]))",
          "legendFormat": "P95 {{model}}"
        }
      ]
    }
  ]
}
